# Database (Supabase PostgreSQL)
# Transaction pooler (Supavisor) - 호스트의 aws-N은 프로젝트별로 다름 (Dashboard > Connect 에서 확인)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (Prisma migrate 전용 - direct 연결 대체)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Server
PORT=3001
NODE_ENV=development

# OCR Provider Configuration
# Options: 'openai', 'google', 'dummy'
OCR_PROVIDER=dummy

# OpenAI API (required if OCR_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Vision API (required if OCR_PROVIDER=google)
# Set this to the path of your Google Cloud service account key JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://kit.dev.9rum.cc:5173,https://kit.dev.9rum.cc,http://kit.dev.9rum.cc

# Push Notifications (VAPID)
# Generate keys with: pnpm run generate:vapid
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:your-email@example.com